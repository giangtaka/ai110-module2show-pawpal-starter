classDiagram

class Owner {
    +str name
    +list pets
    +add_pet(pet)
    +get_all_tasks()
}

class Pet {
    +str name
    +str species
    +list tasks
    +add_task(task)
}

class Task {
    +str description
    +str time
    +int duration_minutes
    +str priority
    +str frequency
    +date due_date
    +bool completed
    +mark_complete()
}

class Scheduler {
    +Owner owner
    +sort_by_time()
    +filter_tasks(pet_name, completed)
    +mark_task_complete(pet_name, task_index)
    +find_conflicts()
}

Owner "1" --> "*" Pet : owns
Pet "1" --> "*" Task : has
Scheduler --> Owner : retrieves tasks